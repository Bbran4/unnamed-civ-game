; Engine configuration file.
; Godot 4 project settings for the Unnamed Space Game prototype.

config_version=5

[application]

config/name="Unnamed Space Game"
run/main_scene="res://scenes/main/game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

WorldState="*res://scripts/world_state.gd"
SceneManager="*res://scripts/scene_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

