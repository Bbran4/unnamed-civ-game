[resource]
script = ExtResource("1_script")
id = "frontier_coalition"
display_name = "Frontier Coalition"
description = "A loose alliance of frontier settlements that values local industry and independence."
preferred_station_types = Array[StationTypeData]([ExtResource("station_mining"), ExtResource("station_agricultural"), ExtResource("station_trade")])
preferred_goods = Array[GoodData]([ExtResource("good_fuel"), ExtResource("good_machinery"), ExtResource("good_food")])
