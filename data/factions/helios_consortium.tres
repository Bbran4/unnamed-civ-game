[resource]
script = ExtResource("1_script")
id = "helios_consortium"
display_name = "Helios Mining Consortium"
description = "A corporate mining power focused on resource extraction and industrial expansion."
preferred_station_types = Array[StationTypeData]([ExtResource("station_mining"), ExtResource("station_refinery"), ExtResource("station_industrial")])
preferred_goods = Array[GoodData]([ExtResource("good_steel"), ExtResource("good_ship_components"), ExtResource("good_fuel")])
