[resource]
script = ExtResource("1_script")
id = "colonial_authority"
display_name = "Colonial Authority"
description = "A large administrative power responsible for established colonies, infrastructure, and regulated trade."
preferred_station_types = Array[StationTypeData]([ExtResource("station_trade"), ExtResource("station_industrial"), ExtResource("station_military")])
preferred_goods = Array[GoodData]([ExtResource("good_food"), ExtResource("good_electronics"), ExtResource("good_construction_materials")])
