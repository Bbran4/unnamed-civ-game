[gd_resource type="Resource" script_class="ProductionRecipeData" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/economy/production_recipe_data.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/economy/recipe_ingredient_data.gd" id="ingredient_script"]
[ext_resource type="Resource" path="res://data/economy/goods/steel.tres" id="good_steel"]
[ext_resource type="Resource" path="res://data/economy/goods/electronics.tres" id="good_electronics"]
[ext_resource type="Resource" path="res://data/economy/goods/machinery.tres" id="good_machinery"]
[sub_resource type="Resource" id="Ingredient1"]
script = ExtResource("ingredient_script")
good = ExtResource("good_steel")
quantity = 2

[sub_resource type="Resource" id="Ingredient2"]
script = ExtResource("ingredient_script")
good = ExtResource("good_electronics")
quantity = 1

[resource]
script = ExtResource("1_script")
id = "machinery_manufacturing"
display_name = "Machinery Manufacturing"
description = "Assembles industrial machinery from steel and electronics."
inputs = Array[RecipeIngredientData]([SubResource("Ingredient1"), SubResource("Ingredient2")])
output = ExtResource("good_machinery")
output_quantity = 1
production_time = 150
