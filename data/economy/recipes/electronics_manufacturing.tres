[gd_resource type="Resource" script_class="ProductionRecipeData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/economy/production_recipe_data.gd" id="1_script"]
[ext_resource type="Resource" path="res://data/economy/resources/copper.tres" id="resource_copper"]
[ext_resource type="Resource" path="res://data/economy/resources/rare_earths.tres" id="resource_rare_earths"]
[ext_resource type="Resource" path="res://data/economy/resources/crystals.tres" id="resource_crystals"]
[ext_resource type="Resource" path="res://data/economy/goods/electronics.tres" id="good_electronics"]
[sub_resource type="Resource" id="Ingredient1"]
resource = ExtResource("resource_copper")
quantity = 2

[sub_resource type="Resource" id="Ingredient2"]
resource = ExtResource("resource_rare_earths")
quantity = 0.5

[sub_resource type="Resource" id="Ingredient3"]
resource = ExtResource("resource_crystals")
quantity = 0.25

[resource]
script = ExtResource("1_script")
id = "electronics_manufacturing"
display_name = "Electronics Manufacturing"
description = "Builds electronic components from conductive and rare materials."
inputs = Array[RecipeIngredientData]([SubResource("Ingredient1"), SubResource("Ingredient2"), SubResource("Ingredient3")])
output = ExtResource("good_electronics")
output_quantity = 2
production_time = 120
