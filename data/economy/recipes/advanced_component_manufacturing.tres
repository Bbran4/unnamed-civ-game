[gd_resource type="Resource" script_class="ProductionRecipeData" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/economy/production_recipe_data.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/economy/recipe_ingredient_data.gd" id="ingredient_script"]
[ext_resource type="Resource" path="res://data/economy/resources/crystals.tres" id="resource_crystals"]
[ext_resource type="Resource" path="res://data/economy/resources/helium.tres" id="resource_helium"]
[ext_resource type="Resource" path="res://data/economy/goods/electronics.tres" id="good_electronics"]
[ext_resource type="Resource" path="res://data/economy/goods/advanced_components.tres" id="good_advanced_components"]
[sub_resource type="Resource" id="Ingredient1"]
script = ExtResource("ingredient_script")
good = ExtResource("good_electronics")
quantity = 2

[sub_resource type="Resource" id="Ingredient2"]
script = ExtResource("ingredient_script")
resource = ExtResource("resource_crystals")
quantity = 1

[sub_resource type="Resource" id="Ingredient3"]
script = ExtResource("ingredient_script")
resource = ExtResource("resource_helium")
quantity = 1

[resource]
script = ExtResource("1_script")
id = "advanced_component_manufacturing"
display_name = "Advanced Component Manufacturing"
description = "Produces high-value components from electronics, crystals, and helium."
inputs = Array[RecipeIngredientData]([SubResource("Ingredient1"), SubResource("Ingredient2"), SubResource("Ingredient3")])
output = ExtResource("good_advanced_components")
output_quantity = 1
production_time = 240
