[gd_resource type="Resource" script_class="ProductionRecipeData" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/economy/production_recipe_data.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/economy/recipe_ingredient_data.gd" id="ingredient_script"]
[ext_resource type="Resource" path="res://data/economy/resources/hydrogen.tres" id="resource_hydrogen"]
[ext_resource type="Resource" path="res://data/economy/resources/carbon.tres" id="resource_carbon"]
[ext_resource type="Resource" path="res://data/economy/goods/fuel.tres" id="good_fuel"]
[sub_resource type="Resource" id="Ingredient1"]
script = ExtResource("ingredient_script")
resource = ExtResource("resource_hydrogen")
quantity = 3

[sub_resource type="Resource" id="Ingredient2"]
script = ExtResource("ingredient_script")
resource = ExtResource("resource_carbon")
quantity = 1

[resource]
script = ExtResource("1_script")
id = "fuel_refining"
display_name = "Fuel Refining"
description = "Refines hydrogen and carbon into ship fuel."
inputs = Array[RecipeIngredientData]([SubResource("Ingredient1"), SubResource("Ingredient2")])
output = ExtResource("good_fuel")
output_quantity = 2
production_time = 45
