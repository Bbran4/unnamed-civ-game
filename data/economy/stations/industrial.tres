[resource]
script = ExtResource("1_script")
id = "industrial"
display_name = "Industrial Station"
description = "Converts raw materials into machinery, electronics, and construction goods."
population_multiplier = 1.4
industries = Array[String](["Manufacturing"])
resource_imports = Array[ResourceData]([])
resource_exports = Array[ResourceData]([])
good_imports = Array[GoodData]([ExtResource("good_fuel")])
good_exports = Array[GoodData]([ExtResource("good_steel"), ExtResource("good_electronics"), ExtResource("good_machinery"), ExtResource("good_construction_materials")])
production_recipes = Array[ProductionRecipeData]([ExtResource("recipe_steelmaking"), ExtResource("recipe_electronics_manufacturing"), ExtResource("recipe_machinery_manufacturing"), ExtResource("recipe_construction_material_production")])
