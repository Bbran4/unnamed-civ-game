[ext_resource type="Resource" path="res://data/economy/recipes/fertilizer_production.tres" id="recipe_fertilizer_production"]

[resource]
script = ExtResource("1_script")
id = "agricultural"
display_name = "Agricultural Station"
description = "Produces food and biological goods using controlled agriculture."
population_multiplier = 1.8
industries = Array[String](["Agriculture"])
resource_imports = Array[ResourceData]([ExtResource("resource_water")])
resource_exports = Array[ResourceData]([ExtResource("resource_organic_matter")])
good_imports = Array[GoodData]([ExtResource("good_fuel"), ExtResource("good_machinery"), ExtResource("good_fertilizer")])
good_exports = Array[GoodData]([ExtResource("good_food"), ExtResource("good_fertilizer")])
production_recipes = Array[ProductionRecipeData]([ExtResource("recipe_food_processing"), ExtResource("recipe_fertilizer_production")])
